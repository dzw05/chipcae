if(CHIPCAE_ENABLE_OCCT)
    find_package(OpenCASCADE REQUIRED COMPONENTS FoundationClasses ModelingData
        ModelingAlgorithms Visualization ApplicationFramework DataExchange)
    if(DEFINED OpenCASCADE_BUILD_SHARED_LIBS AND NOT OpenCASCADE_BUILD_SHARED_LIBS)
        message(FATAL_ERROR "OCCT requires dynamic linking (LGPL, ADR-0007)")
    endif()
    if(TARGET TKernel)
        get_target_property(_occt_tkernel_type TKernel TYPE)
        if(_occt_tkernel_type STREQUAL "STATIC_LIBRARY")
            message(FATAL_ERROR "OCCT requires dynamic linking (LGPL, ADR-0007): TKernel is static")
        endif()
    endif()
endif()

if(CHIPCAE_ENABLE_PYTHON)
    find_package(Python 3.9 REQUIRED COMPONENTS Interpreter Development.Module)
    find_package(nanobind CONFIG REQUIRED)
endif()

if(CHIPCAE_ENABLE_MUMPS)
    find_package(MUMPS REQUIRED)
    foreach(_hint MUMPS_BUILD_SHARED_LIBS MUMPS_SHARED_LIBS MUMPS_BUILD_SHARED)
        if(DEFINED ${_hint} AND NOT ${_hint})
            message(FATAL_ERROR "MUMPS requires dynamic linking (CeCILL-C policy)")
        endif()
    endforeach()
    set(_mumps_libraries ${MUMPS_LIBRARIES} ${MUMPS_LIBRARY})
    get_property(_mumps_targets DIRECTORY PROPERTY IMPORTED_TARGETS)
    foreach(_target IN LISTS _mumps_targets)
        if(_target MATCHES "[Mm][Uu][Mm][Pp][Ss]")
            get_target_property(_type ${_target} TYPE)
            if(_type STREQUAL "STATIC_LIBRARY")
                message(FATAL_ERROR "MUMPS target ${_target} is static; dynamic linking is required")
            endif()
            foreach(_config "" _RELEASE _DEBUG _RELWITHDEBINFO _MINSIZEREL)
                get_target_property(_location ${_target} IMPORTED_LOCATION${_config})
                if(_location)
                    list(APPEND _mumps_libraries "${_location}")
                endif()
            endforeach()
        endif()
    endforeach()
    foreach(_library IN LISTS _mumps_libraries)
        if(_library MATCHES "\\.a$")
            message(FATAL_ERROR "MUMPS static archive ${_library} is forbidden; use shared libraries")
        elseif(_library MATCHES "\\.lib$")
            get_filename_component(_dir "${_library}" DIRECTORY)
            get_filename_component(_stem "${_library}" NAME_WE)
            if(NOT EXISTS "${_dir}/${_stem}.dll" AND NOT EXISTS "${_dir}/../bin/${_stem}.dll")
                message(FATAL_ERROR "MUMPS .lib requires a corresponding shared DLL: ${_library}")
            endif()
        endif()
    endforeach()
endif()

if(CHIPCAE_ENABLE_ECAD)
    # Discover in this configure so packages retain the caller's variables,
    # helpers, targets and policies. Local imports stay in the child directory;
    # ordinary targets and explicit GLOBAL imports may remain visible.
    set(_chipcae_miniz_discovery "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/chipcae-miniz-discovery")
    file(MAKE_DIRECTORY "${_chipcae_miniz_discovery}")
    file(WRITE "${_chipcae_miniz_discovery}/CMakeLists.txt" [=[
set(CMAKE_FIND_PACKAGE_TARGETS_GLOBAL OFF)
find_package(miniz CONFIG QUIET)
set(_accepted FALSE)
set(_rejected FALSE)
set(_aliases "")
foreach(_name miniz::miniz miniz)
    if(TARGET ${_name})
        get_target_property(_type ${_name} TYPE)
        if(_type STREQUAL "SHARED_LIBRARY" OR _type STREQUAL "MODULE_LIBRARY")
            set(_rejected TRUE)
        else()
            set(_accepted TRUE)
        endif()
    endif()
endforeach()
if(_rejected)
    set(_accepted FALSE)
endif()
if(_accepted)
    # Aliases of local imports stay local even after their targets are promoted.
    foreach(_name miniz::miniz miniz)
        if(TARGET ${_name})
            get_target_property(_underlying ${_name} ALIASED_TARGET)
            if(_underlying)
                list(APPEND _aliases ${_name} ${_underlying})
            endif()
        endif()
    endforeach()
    get_property(_imports DIRECTORY PROPERTY IMPORTED_TARGETS)
    # M-a ruling (2026-11-27 15:12): promote only the miniz targets ECAD uses
    # and their transitive link dependencies; unrelated package imports stay local.
    set(_queue "")
    set(_visited "")
    set(_promote "")
    foreach(_name miniz::miniz miniz)
        if(TARGET ${_name})
            list(APPEND _queue ${_name})
        endif()
    endforeach()
    while(_queue)
        list(POP_FRONT _queue _target)
        get_target_property(_underlying ${_target} ALIASED_TARGET)
        if(_underlying)
            set(_target ${_underlying})
        endif()
        if(_target IN_LIST _visited)
            continue()
        endif()
        list(APPEND _visited ${_target})
        # Only this directory's imports may be promoted, even when the closure
        # also traverses caller-owned imports or ordinary build targets.
        if(_target IN_LIST _imports)
            get_target_property(_global ${_target} IMPORTED_GLOBAL)
            if(NOT _global)
                list(APPEND _promote ${_target})
            endif()
        endif()
        get_target_property(_links ${_target} INTERFACE_LINK_LIBRARIES)
        foreach(_dependency IN LISTS _links)
            if(_dependency MATCHES "^\\$<LINK_ONLY:(.*)>$")
                set(_dependency "${CMAKE_MATCH_1}")
            endif()
            if(_dependency MATCHES "\\$<" OR NOT TARGET "${_dependency}")
                continue()
            endif()
            list(APPEND _queue "${_dependency}")
        endforeach()
    endwhile()
    foreach(_target IN LISTS _promote)
        set_property(TARGET ${_target} PROPERTY IMPORTED_GLOBAL TRUE)
    endforeach()
endif()
set(_chipcae_miniz_package_accepted ${_accepted} PARENT_SCOPE)
set(_chipcae_miniz_aliases "${_aliases}" PARENT_SCOPE)
]=])
    add_subdirectory("${_chipcae_miniz_discovery}" "${_chipcae_miniz_discovery}/build")
    while(_chipcae_miniz_aliases)
        list(POP_FRONT _chipcae_miniz_aliases _chipcae_miniz_alias _chipcae_miniz_underlying)
        if(NOT TARGET ${_chipcae_miniz_alias})
            add_library(${_chipcae_miniz_alias} ALIAS ${_chipcae_miniz_underlying})
        endif()
    endwhile()
    if(NOT _chipcae_miniz_package_accepted)
        include(FetchContent)
        if(DEFINED BUILD_SHARED_LIBS)
            set(_chipcae_miniz_had_shared TRUE)
            set(_chipcae_miniz_shared "${BUILD_SHARED_LIBS}")
        else()
            set(_chipcae_miniz_had_shared FALSE)
        endif()
        set(BUILD_SHARED_LIBS OFF)
        set(BUILD_EXAMPLES OFF CACHE BOOL "Build miniz examples" FORCE)
        set(INSTALL_PROJECT OFF CACHE BOOL "Install miniz" FORCE)
        set(_chipcae_miniz_source_subdir ".")
        if(TARGET miniz OR TARGET miniz::miniz)
            # Rejected GLOBAL imports, build targets and aliases cannot be
            # removed. Populate the pinned source without its public target,
            # then compile a private archive for the unchanged ECAD consumer.
            set(_chipcae_miniz_source_subdir "chipcae-populate-only")
        endif()
        FetchContent_Declare(miniz
            URL https://codeload.github.com/richgel999/miniz/tar.gz/refs/tags/3.0.2
            URL_HASH SHA256=c4b4c25a4eb81883448ff8924e6dba95c800094a198dc9ce66a292ac2ef8e018
            SOURCE_SUBDIR "${_chipcae_miniz_source_subdir}"
        )
        if(DEFINED CMAKE_POLICY_DEFAULT_CMP0077)
            set(_chipcae_miniz_saved_policy "${CMAKE_POLICY_DEFAULT_CMP0077}")
        endif()
        set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
        # miniz 3.0.2 declares CMake 3.0 compatibility, removed in CMake 4.
        # Limit the compatibility override to this dependency and preserve any
        # stricter policy minimum supplied by the caller.
        if(DEFINED CMAKE_POLICY_VERSION_MINIMUM)
            set(_chipcae_miniz_saved_minimum "${CMAKE_POLICY_VERSION_MINIMUM}")
        endif()
        if(NOT DEFINED CMAKE_POLICY_VERSION_MINIMUM OR
           CMAKE_POLICY_VERSION_MINIMUM VERSION_LESS 3.5)
            set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
        endif()
        FetchContent_MakeAvailable(miniz)
        if(_chipcae_miniz_source_subdir STREQUAL "chipcae-populate-only")
            set(_chipcae_miniz_static_dir "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/chipcae-static-miniz")
            file(MAKE_DIRECTORY "${_chipcae_miniz_static_dir}")
            file(WRITE "${_chipcae_miniz_static_dir}/CMakeLists.txt" [=[
# Sources and export settings of the pinned miniz 3.0.2 static build.
add_library(chipcae_miniz_static STATIC
    "${miniz_SOURCE_DIR}/miniz.c" "${miniz_SOURCE_DIR}/miniz_zip.c"
    "${miniz_SOURCE_DIR}/miniz_tinfl.c" "${miniz_SOURCE_DIR}/miniz_tdef.c")
set_target_properties(chipcae_miniz_static PROPERTIES OUTPUT_NAME miniz C_STANDARD 90)
include(GenerateExportHeader)
generate_export_header(chipcae_miniz_static BASE_NAME miniz)
target_compile_definitions(chipcae_miniz_static PUBLIC MINIZ_STATIC_DEFINE
    PRIVATE $<$<C_COMPILER_ID:GNU>:_GNU_SOURCE>)
target_include_directories(chipcae_miniz_static PUBLIC
    "$<BUILD_INTERFACE:${miniz_SOURCE_DIR}>"
    "$<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}>")
]=])
            add_subdirectory("${_chipcae_miniz_static_dir}" "${_chipcae_miniz_static_dir}/build")
            if(TARGET miniz::miniz)
                # CMP0107's compatibility behavior permits replacing this one
                # occupied public name with an alias. The package's real target
                # and artifacts remain intact; restore the caller's policy
                # immediately, without intercepting any CMake commands.
                cmake_policy(PUSH)
                cmake_policy(SET CMP0107 OLD)
                add_library(miniz::miniz ALIAS chipcae_miniz_static)
                cmake_policy(POP)
            else()
                add_library(miniz::miniz ALIAS chipcae_miniz_static)
            endif()
            unset(_chipcae_miniz_static_dir)
        endif()
        unset(_chipcae_miniz_source_subdir)
        if(DEFINED _chipcae_miniz_saved_minimum)
            set(CMAKE_POLICY_VERSION_MINIMUM "${_chipcae_miniz_saved_minimum}")
            unset(_chipcae_miniz_saved_minimum)
        else()
            unset(CMAKE_POLICY_VERSION_MINIMUM)
        endif()
        if(DEFINED _chipcae_miniz_saved_policy)
            set(CMAKE_POLICY_DEFAULT_CMP0077 "${_chipcae_miniz_saved_policy}")
            unset(_chipcae_miniz_saved_policy)
        else()
            unset(CMAKE_POLICY_DEFAULT_CMP0077)
        endif()
        if(_chipcae_miniz_had_shared)
            set(BUILD_SHARED_LIBS "${_chipcae_miniz_shared}")
        else()
            unset(BUILD_SHARED_LIBS)
        endif()
        unset(_chipcae_miniz_had_shared)
        unset(_chipcae_miniz_shared)
    endif()
    unset(_chipcae_miniz_discovery)
    unset(_chipcae_miniz_package_accepted)
    unset(_chipcae_miniz_aliases)
    unset(_chipcae_miniz_alias)
    unset(_chipcae_miniz_underlying)

    find_package(Clipper2 CONFIG QUIET)
    if(NOT TARGET Clipper2)
        include(FetchContent)
        set(CLIPPER2_UTILS OFF CACHE BOOL "Build Clipper2 utilities" FORCE)
        set(CLIPPER2_EXAMPLES OFF CACHE BOOL "Build Clipper2 examples" FORCE)
        set(CLIPPER2_TESTS OFF CACHE BOOL "Build Clipper2 tests" FORCE)
        set(CLIPPER2_HI_PRECISION OFF CACHE BOOL "Use Clipper2 high precision" FORCE)
        set(CLIPPER2_USINGZ OFF CACHE STRING "Build only the non-Z Clipper2 library" FORCE)
        if(DEFINED BUILD_SHARED_LIBS)
            set(_chipcae_had_build_shared_libs TRUE)
            set(_chipcae_saved_build_shared_libs "${BUILD_SHARED_LIBS}")
        else()
            set(_chipcae_had_build_shared_libs FALSE)
        endif()
        set(BUILD_SHARED_LIBS OFF)
        FetchContent_Declare(Clipper2
            URL https://github.com/PolyClipping/Clipper2/archive/refs/tags/Clipper2_2.0.1.tar.gz
            URL_HASH SHA256=2a3693aceab4aed3e39b743e038d87701acc53cf05ed7b2013aab3e0aec5287e
            SOURCE_SUBDIR CPP
        )
        FetchContent_MakeAvailable(Clipper2)
        if(_chipcae_had_build_shared_libs)
            set(BUILD_SHARED_LIBS "${_chipcae_saved_build_shared_libs}")
        else()
            unset(BUILD_SHARED_LIBS)
        endif()
        unset(_chipcae_had_build_shared_libs)
        unset(_chipcae_saved_build_shared_libs)
    endif()

    find_package(EXPAT QUIET)
    if(NOT TARGET EXPAT::EXPAT AND NOT TARGET expat)
        include(FetchContent)
        set(EXPAT_BUILD_TOOLS OFF CACHE BOOL "Build Expat tools" FORCE)
        set(EXPAT_BUILD_EXAMPLES OFF CACHE BOOL "Build Expat examples" FORCE)
        set(EXPAT_BUILD_TESTS OFF CACHE BOOL "Build Expat tests" FORCE)
        set(EXPAT_BUILD_DOCS OFF CACHE BOOL "Build Expat documentation" FORCE)
        set(EXPAT_SHARED_LIBS OFF CACHE BOOL "Build static Expat" FORCE)
        FetchContent_Declare(EXPAT
            URL https://github.com/libexpat/libexpat/archive/refs/tags/R_2_10_0.tar.gz
            URL_HASH SHA256=b3644a12f62d7762b62c444f69d169ba0234f13138d0240244bca64cbe35286f
            SOURCE_SUBDIR expat
        )
        FetchContent_MakeAvailable(EXPAT)
    endif()
endif()
