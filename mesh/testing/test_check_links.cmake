cmake_minimum_required(VERSION 3.20)
file(MAKE_DIRECTORY "${TEST_DIR}")
foreach(case missing empty)
  set(graph "${TEST_DIR}/${case}.cmake")
  if(case STREQUAL "missing")
    file(WRITE "${graph}" "")
  else()
    file(WRITE "${graph}" "set(links_chipcae_mesh_fixture \"\")\n")
  endif()
  execute_process(COMMAND cmake "-DGRAPH=${graph}" -P "${CHECK}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT error MATCHES "Missing or empty fixture link graph")
    message(FATAL_ERROR "${case} graph did not fail at graph validation: ${output}${error}")
  endif()
endforeach()
