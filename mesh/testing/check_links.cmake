cmake_minimum_required(VERSION 3.20)
include("${GRAPH}")
function(visit target)
  if("${target}" MATCHES "\\$<")
    message(FATAL_ERROR "Unresolved generator expression: ${target}")
  endif()
  if("${target}" MATCHES "[Bb][Aa][Cc][Kk][Gg][Rr][Oo][Uu][Nn][Dd]|^chipcae_mesh_cut$|[Mm][Ff][Ee][Mm]|[Pp][Rr][Ee][Vv][Ii][Ee][Ww]")
    message(FATAL_ERROR "Forbidden fixture dependency: ${target}")
  endif()
  get_property(seen GLOBAL PROPERTY i5_seen)
  if("${target}" IN_LIST seen)
    return()
  endif()
  set_property(GLOBAL APPEND PROPERTY i5_seen "${target}")
  foreach(link IN LISTS links_${target})
    if(NOT "${link}" STREQUAL "")
      visit("${link}")
    endif()
  endforeach()
endfunction()
visit(chipcae_mesh_fixture)
execute_process(COMMAND "${SMOKE}" "${FIXTURE}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Fixture-only consumer failed: ${result}")
endif()
