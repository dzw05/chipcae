include(${CMAKE_CURRENT_LIST_DIR}/SDKLock.cmake)
find_package(Qt6 6.5 REQUIRED COMPONENTS Core Gui Widgets OpenGLWidgets)
find_package(VTK 9.7 REQUIRED COMPONENTS CommonCore CommonDataModel FiltersSources
    RenderingCore RenderingOpenGL2 InteractionStyle GUISupportQt IOHDF IOImage
    ChartsCore ViewsContext2D RenderingContextOpenGL2)
if(NOT VTK_VERSION VERSION_LESS 9.8)
    message(FATAL_ERROR "D01 requires VTK 9.7.x")
endif()
if(NOT VTK_QT_VERSION STREQUAL "6")
    message(FATAL_ERROR "VTK must use Qt6; found '${VTK_QT_VERSION}'")
endif()
set(CHIPCAE_JSONCONS_PREFIX "/workspace/deps/jsoncons" CACHE PATH "Locked header-only jsoncons prefix")
find_package(jsoncons 1.4.0 EXACT CONFIG REQUIRED PATHS "${CHIPCAE_JSONCONS_PREFIX}" NO_DEFAULT_PATH)
find_package(Protobuf CONFIG REQUIRED)
message(STATUS "Desktop SDK: Qt ${Qt6_VERSION}, VTK ${VTK_VERSION}, protobuf ${Protobuf_VERSION}")
foreach(config_dir Qt6_DIR VTK_DIR Protobuf_DIR)
    cmake_path(IS_PREFIX CMAKE_PREFIX_PATH "${${config_dir}}" NORMALIZE in_sdk)
    if(NOT in_sdk)
        message(FATAL_ERROR "${config_dir} must be inside the locked CMAKE_PREFIX_PATH")
    endif()
endforeach()
get_filename_component(compiler_real "${CMAKE_CXX_COMPILER}" REALPATH)
get_filename_component(locked_compiler "/workspace/tools/chipcae-desktop/bin/c++" REALPATH)
if(NOT compiler_real STREQUAL locked_compiler)
    message(FATAL_ERROR "Use the locked SDK compiler via PATH before first configure")
endif()
