{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chipcae.local/tools/vv/calculix_trilayer/reference.schema.json",
  "title": "WP-2 trilayer CalculiX REFERENCE artifact",
  "description": "WP-2 v1 contract with exactly coarse and fine meshes and fine selection. Full validation requires normalizing a copy with the selected name and top-level W_bfp_m as a const/contains constraint; the raw schema alone cannot enforce equality between instance fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "label",
    "W_bfp_m",
    "element_type",
    "geometry",
    "meshes",
    "selected_mesh",
    "prototype_W_bfp_m",
    "abs_delta_m",
    "rel_delta"
  ],
  "properties": {
    "schema_version": { "const": "1", "type": "string" },
    "kind": { "const": "REFERENCE", "type": "string" },
    "label": { "type": "string", "minLength": 1 },
    "W_bfp_m": { "type": "number" },
    "element_type": { "type": "string", "minLength": 1 },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L_m", "thicknesses_m", "E_Pa", "nu", "alpha_1_per_K", "dT_K"],
      "properties": {
        "L_m": { "type": "number" },
        "thicknesses_m": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "E_Pa": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "nu": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "alpha_1_per_K": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
        "dT_K": { "type": "number" }
      }
    },
    "meshes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "allOf": [
        {
          "contains": { "properties": { "name": { "const": "coarse" } }, "required": ["name"] },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "properties": { "name": { "const": "fine" } }, "required": ["name"] },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "n_elem_xyz", "n_elem_z_per_layer", "W_bfp_m"],
        "properties": {
          "name": { "type": "string", "enum": ["coarse", "fine"] },
          "n_elem_xyz": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer" } },
          "n_elem_z_per_layer": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer" } },
          "W_bfp_m": { "type": "number" }
        }
      }
    },
    "selected_mesh": { "type": "string", "const": "fine" },
    "prototype_W_bfp_m": { "type": "number" },
    "abs_delta_m": { "type": "number" },
    "rel_delta": { "type": "number" },
    "provenance": {
      "type": "object",
      "description": "Optional, non-contractual generator metadata. Ignoring unknown keys under provenance is a consumer convention outside schema enforcement; additionalProperties is true so new metadata can be added without a schema bump.",
      "additionalProperties": true,
      "properties": {
        "generator": { "type": "string" },
        "calculix_version": {
          "type": "string",
          "minLength": 1,
          "description": "Free-form ccx banner; informational, not a stable token."
        },
        "host": { "type": "string", "minLength": 1, "description": "Optional execution-host provenance." },
        "label": { "type": "string", "description": "Human-readable prose; not for programmatic comparison." }
      }
    }
  }
}
