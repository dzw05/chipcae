cmake_minimum_required(VERSION 3.20)

# Check the caller and configure-only fixtures; never build or execute solver tests.
foreach(_argument IN ITEMS BUILD_DIR CONFIG GENERATOR ECAD SOLVE_BACKEND HAS_IMPORT HAS_PREVIEW)
    if(NOT DEFINED ${_argument})
        message(FATAL_ERROR "Missing required argument: ${_argument}")
    endif()
endforeach()
if(BUILD_DIR STREQUAL "" OR NOT IS_DIRECTORY "${BUILD_DIR}")
    message(FATAL_ERROR "BUILD_DIR must name an existing build tree")
endif()
foreach(_argument IN ITEMS ECAD SOLVE_BACKEND HAS_IMPORT HAS_PREVIEW)
    if(NOT "${${_argument}}" MATCHES "^(0|1|ON|OFF|TRUE|FALSE)$")
        message(FATAL_ERROR "${_argument} must be an explicit boolean")
    endif()
endforeach()

function(check_registration BUILD_DIR ECAD SOLVE_BACKEND HAS_IMPORT HAS_PREVIEW)
    execute_process(
        COMMAND ctest --test-dir "${BUILD_DIR}" -C "${CONFIG}" -N --show-only=json-v1
        RESULT_VARIABLE _result OUTPUT_VARIABLE _json ERROR_VARIABLE _stderr)
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "CTest registration query failed (${_result}): ${_stderr}")
    endif()
    # string(JSON) fails fatally for malformed JSON or missing/wrongly typed members.
    string(JSON _tests_type TYPE "${_json}" tests)
    if(NOT _tests_type STREQUAL "ARRAY")
        message(FATAL_ERROR "CTest JSON tests member must be an array")
    endif()
    string(JSON _test_count LENGTH "${_json}" tests)
    set(_names)
    if(_test_count GREATER 0)
        math(EXPR _last "${_test_count} - 1")
        foreach(_index RANGE 0 ${_last})
            string(JSON _name GET "${_json}" tests ${_index} name)
            if(_name IN_LIST _names)
                message(FATAL_ERROR "Duplicate test name: ${_name}")
            endif()
            list(APPEND _names "${_name}")
            set("_index_${_name}" "${_index}")
        endforeach()
    endif()

    set(_errors "")
    set(_targets solve_copper_trace_map_paths solve_fem_thermal_bow
        solve_fvm_trace_map solve_lu_refine_floor solve_ecad_test_registration)
    # These values freeze the existing registration contract; update deliberately
    # alongside any approved TIMEOUT changes in tests/solve/CMakeLists.txt.
    set(_timeouts 600 600 900 600 60)
    foreach(_position RANGE 0 4)
        list(GET _targets ${_position} _name)
        list(GET _timeouts ${_position} _timeout)
        set(_expected 1)
        set(_reasons)
        if(NOT _name STREQUAL "solve_ecad_test_registration")
            if(NOT ECAD)
                list(APPEND _reasons "CHIPCAE_ENABLE_ECAD=OFF")
            endif()
            if(NOT SOLVE_BACKEND)
                list(APPEND _reasons "_solve_backend is false")
            endif()
            if(_name STREQUAL "solve_lu_refine_floor")
                if(NOT HAS_IMPORT)
                    list(APPEND _reasons "target chipcae-import is missing")
                endif()
                if(NOT HAS_PREVIEW)
                    list(APPEND _reasons "target chipcae-preview is missing")
                endif()
            endif()
            if(_reasons)
                set(_expected 0)
                message(STATUS "${_name}: expected absent because ${_reasons}")
            endif()
        endif()
        set(_actual 0)
        if(_name IN_LIST _names)
            set(_actual 1)
        endif()
        if(NOT _actual EQUAL _expected)
            string(APPEND _errors "\n${_name}: expected count ${_expected}, actual ${_actual}")
        endif()
        if(_actual)
            set(_index "${_index_${_name}}")
            string(JSON _properties GET "${_json}" tests ${_index} properties)
            string(JSON _property_count LENGTH "${_properties}")
            set(_found_timeout FALSE)
            if(_property_count GREATER 0)
                math(EXPR _property_last "${_property_count} - 1")
                foreach(_property_index RANGE 0 ${_property_last})
                    string(JSON _property GET "${_properties}" ${_property_index} name)
                    if(_property MATCHES "^(SKIP_RETURN_CODE|WILL_FAIL|DISABLED)$")
                        string(APPEND _errors "\n${_name}: forbidden property ${_property}")
                    endif()
                    if(_property STREQUAL "TIMEOUT")
                        set(_found_timeout TRUE)
                        string(JSON _value GET "${_properties}" ${_property_index} value)
                        if(NOT _value EQUAL _timeout)
                            string(APPEND _errors "\n${_name}: expected TIMEOUT ${_timeout}, actual ${_value}")
                        endif()
                    endif()
                endforeach()
            endif()
            if(NOT _found_timeout)
                string(APPEND _errors "\n${_name}: missing TIMEOUT ${_timeout}")
            endif()
        endif()
    endforeach()
    if(NOT ECAD OR NOT SOLVE_BACKEND OR NOT HAS_IMPORT OR NOT HAS_PREVIEW)
        message(STATUS "完整 ON 注册覆盖未验证 (full ON registration coverage not verified)")
    endif()
    if(_errors)
        message(FATAL_ERROR "ECAD test registration assertions failed:${_errors}")
    endif()
    message(STATUS "ECAD test registration assertions passed: ${BUILD_DIR} (ECAD=${ECAD})")
endfunction()

check_registration("${BUILD_DIR}" "${ECAD}" "${SOLVE_BACKEND}" "${HAS_IMPORT}" "${HAS_PREVIEW}")

# Use the real solve test declarations with configure-only dependency targets.
# Force an available backend and both tools so ON coverage cannot silently vanish
# when the caller lacks optional dependencies. CTest remains the source of truth.
set(_fixture "${BUILD_DIR}/tests/solve/ecad_registration")
file(MAKE_DIRECTORY "${_fixture}/source")
file(WRITE "${_fixture}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.20)
project(ecad_registration LANGUAGES CXX)
enable_testing()
find_package(Python3 COMPONENTS Interpreter REQUIRED)
function(chipcae_set_warnings)
endfunction()
foreach(_library IN ITEMS mfem MPI::MPI_CXX chipcae::fem chipcae::io jsoncons chipcae_mesh_cut)
    add_library(${_library} INTERFACE IMPORTED)
endforeach()
foreach(_tool IN ITEMS chipcae-solve chipcae-import chipcae-preview)
    add_executable(${_tool} IMPORTED)
    set_target_properties(${_tool} PROPERTIES IMPORTED_LOCATION "${CMAKE_COMMAND}")
endforeach()
set(_solve_backend ON)
add_subdirectory("${CHIPCAE_SOURCE_DIR}/tests/solve" solve)
]=])
get_filename_component(_source_dir "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
foreach(_ecad IN ITEMS ON OFF)
    set(_build "${_fixture}/${_ecad}")
    execute_process(
        COMMAND cmake -G "${GENERATOR}" -S "${_fixture}/source" -B "${_build}"
            "-DCHIPCAE_SOURCE_DIR=${_source_dir}" "-DCHIPCAE_ENABLE_ECAD=${_ecad}"
            -DCMAKE_BUILD_TYPE=Release
        RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "ECAD=${_ecad} fixture configure failed (${_result}):\n${_stdout}\n${_stderr}")
    endif()
    check_registration("${_build}" "${_ecad}" ON ON ON)
endforeach()
