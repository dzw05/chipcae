{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "cpu",
      "displayName": "CPU (Serial + OpenMP, local Kokkos)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-cpu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{KOKKOS_ROOT}",
        "CHIPCAE_MATERIAL_ENABLE_TESTS": "ON",
        "CHIPCAE_MATERIAL_ENABLE_PYTHON": "ON"
      }
    },
    {
      "name": "cpu-fetch",
      "displayName": "CPU (fetch Kokkos)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-cpu-fetch",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CHIPCAE_MATERIAL_FETCH_KOKKOS": "ON",
        "CHIPCAE_MATERIAL_ENABLE_PYTHON": "OFF"
      }
    },
    {
      "name": "cuda",
      "displayName": "CUDA (optional; requires toolkit + Kokkos CUDA build)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-cuda",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{KOKKOS_ROOT}"
      }
    }
  ],
  "buildPresets": [
    { "name": "cpu", "configurePreset": "cpu" },
    { "name": "cpu-fetch", "configurePreset": "cpu-fetch" },
    { "name": "cuda", "configurePreset": "cuda" }
  ],
  "testPresets": [
    {
      "name": "cpu",
      "configurePreset": "cpu",
      "output": { "outputOnFailure": true }
    }
  ]
}
